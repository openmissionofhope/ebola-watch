# Copy to .env and fill in. Never commit .env.
EW_ENV=development
# server (API + worker) or static (scheduled snapshot, e.g. GitHub Pages; SQLite allowed)
EW_DEPLOYMENT=server
# PostgreSQL with PostGIS for production, e.g.:
# EW_DATABASE_URL=postgresql+psycopg://ebolawatch:CHANGE_ME@db:5432/ebolawatch
EW_DATABASE_URL=sqlite:///./var/ebolawatch.db

# Required in production: long random values (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
EW_SECRET_KEY=
EW_PSEUDONYM_SALT=

# Sources with data-use conditions: list keys only after reviewing docs/DATA_SOURCES.md
# EW_SOURCE_ACKNOWLEDGEMENTS=hdx_cod_ebola
# EW_DISABLED_SOURCES=gdelt_doc

# Optional credentials (connectors report "requires_configuration" until set)
# EW_RELIEFWEB_APPNAME=
# EW_YOUTUBE_API_KEY=
# EW_X_BEARER_TOKEN=
# EW_REDDIT_CLIENT_ID=
# EW_REDDIT_CLIENT_SECRET=
# EW_PROMED_FEED_URL=
# EW_RSS_FEEDS=https://example.org/feed.xml,https://example.net/rss

# Publication policy
EW_MIN_PUBLIC_CELL_COUNT=5
EW_MIN_PUBLIC_SUBNATIONAL_POPULATION=50000
EW_PUBLIC_MAX_ADMIN_LEVEL=1
EW_RAW_CONTENT_RETENTION_DAYS=30
EW_SIGNAL_RETENTION_DAYS=365

# API
EW_CORS_ORIGINS=http://localhost:5173
EW_RATE_LIMIT_PER_MINUTE=120
EW_EXPORT_RATE_LIMIT_PER_HOUR=20
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For
EW_TRUST_FORWARDED_FOR=false
