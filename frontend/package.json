{
  "name": "ebolawatch-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "i18n:extract": "node --experimental-strip-types --no-warnings scripts/i18n-check.ts extract",
    "i18n:check": "node --experimental-strip-types --no-warnings scripts/i18n-check.ts check",
    "i18n:coverage": "node --experimental-strip-types --no-warnings scripts/i18n-check.ts coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/d3-scale": "4.0.8",
    "@types/d3-shape": "3.1.6",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.5.4",
    "vite": "5.4.8"
  }
}
